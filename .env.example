# Razorpay test mode. Leave unset to run entirely on the simulated rail.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# A model powers exactly two jobs: scope derivation and semantic divergence.
# Set either provider. Anthropic is preferred when both are present -- it enforces
# the output schema server-side, and it is the stack Razorpay's own Agent Studio
# is built on.
ANTHROPIC_API_KEY=

# Groq's free tier. This exists so a reviewer can reproduce the benchmark
# without paying for anything: https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides.
# WARRANT_PROVIDER=anthropic | groq      (default: try anthropic, then groq)
# WARRANT_MODEL=claude-opus-5 | llama-3.3-70b-versatile
